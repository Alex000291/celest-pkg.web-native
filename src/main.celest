import "std:HTTP";
import "std:TLS";
import "web-core" as web;

extern "C" function celest_cleanup_region_begin() -> byte[8]
extern "C" function celest_cleanup_region_rollback(byte[8] region) -> byte[1]

function NativeServer(handle, port) {
    this.handle = handle;
    this.port = port;
    this.closed = 0;
    return;
}

function NativeSocket(handle) {
    this.handle = handle;
    this.state = 1;
    this.writeHead = 0;
    this.writeTail = 0;
    return;
}

function NativeResponseStream(handle) {
    this.handle = handle;
    this.state = 1;
    return;
}

async function nativeResponseStreamWrite(data) {
    if (this.state != 1) throw "response stream is not writable";
    this.state = 2;
    try {
        byte[1] written = await HTTP.connection_stream_write_async(
            this.handle, data);
        this.state = 1;
        return written;
    } catch error {
        this.state = 4;
        throw error;
    }
}

async function nativeResponseStreamClose() {
    if (this.state == 3) return 1;
    if (this.state != 1) throw "response stream has a pending write";
    this.state = 2;
    try {
        byte[1] closed = await HTTP.connection_stream_end_async(this.handle);
        this.state = 3;
        return closed;
    } catch error {
        this.state = 4;
        throw error;
    }
}

function queueSocketWrite(socket, opcode, data, code) {
    byte[8] write = new Object();
    write.opcode = opcode;
    write.data = data;
    write.code = code;
    write.next = 0;
    if (socket.writeTail == 0) socket.writeHead = (Object)write;
    else socket.writeTail.next = (Object)write;
    socket.writeTail = (Object)write;
    return 1;
}

async function flushSocketWrites(socket) {
    while (socket.writeHead != 0) {
        byte[8] write = (Object)socket.writeHead;
        socket.writeHead = write.next;
        if (socket.writeHead == 0) socket.writeTail = 0;
        if (write.opcode == 8)
            await HTTP.websocket_close_async(socket.handle, write.code, write.data);
        else await HTTP.websocket_write_async(socket.handle, write.opcode, write.data);
    }
    return 1;
}

function nativeSocketSend(data) {
    if (this.state != 1) return 0;
    return queueSocketWrite((Object)this, 1, data, 0);
}

function nativeSocketSendBinary(data) {
    if (this.state != 1) return 0;
    return queueSocketWrite((Object)this, 2, data, 0);
}

function nativeSocketPing(data) {
    if (this.state != 1) return 0;
    return queueSocketWrite((Object)this, 9, data, 0);
}

function nativeSocketPong(data) {
    if (this.state != 1) return 0;
    return queueSocketWrite((Object)this, 10, data, 0);
}

function nativeSocketClose(code, reason) {
    if (this.state != 1) return 1;
    this.state = 2;
    queueSocketWrite((Object)this, 8, reason, code);
    return;
}

async function serveWebSocket(context) {
    byte[32] connection = context.connection;
    byte[8] options = (Object)context.options;
    if (Object.address(options, "protocol") != 0) await HTTP.connection_upgrade_async(connection, options.protocol);
    else await HTTP.connection_upgrade_async(connection, "");
    byte[8] socket = new NativeSocket(connection);
    if (Object.address(options, "open") != 0) {
        options.open((Object)socket);
        await flushSocketWrites((Object)socket);
    }
    byte[8] maximum = 16777216;
    if (Object.address(options, "maximumMessageSize") != 0) maximum = options.maximumMessageSize;
    byte[8] running = 1;
    while (running != 0 && socket.state == 1) {
        byte[8] opcode = await HTTP.websocket_read_async(connection, maximum);
        byte[8] frame = new Object();
        frame.payload = HTTP.connection_value(connection, 6, "");
        if (opcode == 1 || opcode == 2) {
            if (Object.address(options, "message") != 0)
                options.message((Object)socket, frame.payload, opcode == 2);
            await flushSocketWrites((Object)socket);
        } else if (opcode == 9) {
            socket.pong(frame.payload);
            await flushSocketWrites((Object)socket);
        } else if (opcode == 10) {
            if (Object.address(options, "pong") != 0)
                options.pong((Object)socket, frame.payload);
        } else if (opcode == 8) {
            socket.close(HTTP.websocket_close_code(connection),
                HTTP.websocket_close_reason(connection));
            running = 0;
        } else {
            running = 0;
        }
    }
    await flushSocketWrites((Object)socket);
    socket.state = 3;
    if (Object.address(options, "close") != 0) options.close((Object)socket, HTTP.websocket_close_code(connection), HTTP.websocket_close_reason(connection));
    return 1;
}

async function closeWhenIdle(context) {
    byte[1] idle = await context.idle;
    byte[1] finalized = await HTTP.server_finalize_async(context.server.handle);
    Async.resolve(context.closeDone, byte(01));
    Async.resolve(context.done, byte(01));
    return 1;
}

function nativeServerSetTLS(options) {
    if (Object.address((Object)options, "certificate") == 0)
        throw "TLS certificate is required";
    if (Object.address((Object)options, "key") == 0)
        throw "TLS private key is required";
    byte[32] context = TLS.server_context();
    try {
        if (Object.address((Object)options, "passphrase") != 0) {
            byte[1] keyLoaded = TLS.key_loading(
                context, options.key, options.passphrase);
        } else {
            byte[1] keyLoaded = TLS.key_loading(context, options.key, "");
        }
        byte[1] certificateLoaded = TLS.certificate_loading(
            context, options.certificate);
        HTTP.server_tls(this.handle, context);
    } catch error {
        byte[1] released = TLS.explicit_release(context);
        throw error;
    }
    byte[1] released = TLS.explicit_release(context);
    return 1;
}

function addHandler(context, handler) {
    byte[32] emptyDeadline = byte(00);
    handler.next = context.handlerHead;
    handler.deadline = emptyDeadline;
    handler.responseActive = 0;
    handler.shutdownOwner = 0;
    handler.abortRequested = 0;
    context.handlerHead = (Object)handler;
    return 1;
}

function removeHandler(context, handler) {
    if (handler.deadline != 0) {
        Async.deadline_close(handler.deadline);
        byte[32] emptyDeadline = byte(00);
        handler.deadline = emptyDeadline;
    }
    byte[8] previous = 0;
    byte[8] current = context.handlerHead;
    while (current != 0) {
        byte[8] next = current.next;
        if (current == handler) {
            if (previous == 0) context.handlerHead = next;
            else previous.next = next;
            break;
        }
        previous = (Object)current;
        current = (Object)next;
    }
    handler.next = 0;
    return 1;
}

function deadlineHandlers(context) {
    if (context.shutdownTimeoutMs == 0) return 0;
    byte[8] handler = context.handlerHead;
    while (handler != 0) {
        byte[8] next = handler.next;
        if (handler.routeActive == 0 && handler.responseActive != 0 &&
            handler.deadline == 0 &&
            Async.is_task(handler.task) != 0 && Async.state(handler.task) == 0)
            handler.deadline = Async.deadline(handler.task,
                context.shutdownTimeoutMs);
        handler = (Object)next;
    }
    return 1;
}

function closeWaitingHandlers(context) {
    byte[8] handler = context.handlerHead;
    while (handler != 0) {
        if (handler.routeActive == 0 && handler.responseActive == 0 &&
            handler.shutdownOwner == 0 && handler.connection != 0 &&
            handler.abortRequested == 0) {
            handler.abortRequested = 1;
            HTTP.connection_shutdown(handler.connection);
            handler = context.handlerHead;
        } else {
            handler = (Object)handler.next;
        }
    }
    return 1;
}

function addRoute(context, route) {
    byte[32] emptyDeadline = byte(00);
    route.next = context.routeHead;
    route.deadline = emptyDeadline;
    context.routeHead = (Object)route;
    return 1;
}

function removeRoute(context, route) {
    if (route.deadline != 0) {
        Async.deadline_close(route.deadline);
        byte[32] emptyDeadline = byte(00);
        route.deadline = emptyDeadline;
    }
    byte[8] previous = 0;
    byte[8] current = context.routeHead;
    while (current != 0) {
        byte[8] next = current.next;
        if (current == route) {
            if (previous == 0) context.routeHead = next;
            else previous.next = next;
            break;
        }
        previous = (Object)current;
        current = (Object)next;
    }
    route.next = 0;
    return 1;
}

function deadlineRoutes(context) {
    if (context.shutdownTimeoutMs == 0) return 0;
    byte[8] route = context.routeHead;
    while (route != 0) {
        byte[8] next = route.next;
        if (route.deadline == 0 && Async.is_task(route.task) != 0 &&
            Async.state(route.task) == 0)
            route.deadline = Async.deadline(route.task,
                context.shutdownTimeoutMs);
        route = (Object)next;
    }
    return 1;
}

function nativeServerClose() {
    if (this.closed != 0) return this.lifecycle.closeDone;
    this.closed = 1;
    byte[8] context = 0;
    if (Object.address((Object)this, "lifecycle") != 0)
        context = (Object)this.lifecycle;
    else {
        context = new Object();
        context.done = Async.create();
        context.requestLimit = 0;
        context.shutdownTimeoutMs = 0;
        byte[8] emptyHandler = 0;
        context.handlerHead = emptyHandler;
        byte[8] emptyRoute = 0;
        context.routeHead = emptyRoute;
        context.server = (Object)this;
        this.lifecycle = (Object)context;
    }
    if (context.requestLimit != 0) {
        context.closeDone = HTTP.server_finalize_async(this.handle);
        return context.closeDone;
    }
    context.closeDone = Async.create();
    HTTP.server_stop(this.handle);
    closeWaitingHandlers((Object)context);
    deadlineRoutes((Object)context);
    deadlineHandlers((Object)context);
    byte[32] idle = HTTP.server_idle_async(this.handle);
    context.idle = idle;
    byte[32] closing = closeWhenIdle((Object)context);
    Async.detach(closing);
    return context.closeDone;
}

function nativeRequestBodyRead(request, maximum) {
    if (request.disconnectWatch != 0) {
        HTTP.connection_unwatch_disconnect(request.nativeConnection,
            request.disconnectWatch);
        request.disconnectWatch = 0;
    }
    return HTTP.connection_body_read_async(request.nativeConnection, maximum);
}

function nativeRequestBodyReadAll(request) {
    if (request.disconnectWatch != 0) {
        HTTP.connection_unwatch_disconnect(request.nativeConnection,
            request.disconnectWatch);
        request.disconnectWatch = 0;
    }
    return HTTP.connection_body_read_all_async(request.nativeConnection);
}

function nativeRequestBodyComplete(request) {
    return HTTP.connection_body_complete(request.nativeConnection);
}

function nativeRequestHeader(request, name) {
    return HTTP.connection_value(request.nativeConnection, 3, name);
}

function nativeRequestQuery(request, name) {
    return HTTP.connection_value(request.nativeConnection, 4, name);
}

function nativeRequestCookie(request, name) {
    return HTTP.connection_value(request.nativeConnection, 5, name);
}

function nativeRequestForm(request, name) {
    return HTTP.connection_value(request.nativeConnection, 7, name);
}

function nativeRequestMultipart(request, name) {
    return HTTP.connection_value(request.nativeConnection, 8, name);
}

function nativeRequestMultipartName(request, name) {
    return HTTP.connection_value(request.nativeConnection, 9, name);
}

function createNativeRequest(connection, requestPrototype) {
    byte[8] streaming = HTTP.connection_body_streaming(connection);
    byte[8] request = 0;
    if (streaming == 0)
        request = HTTP.connection_request(connection, requestPrototype);
    else {
        request = web.request(HTTP.connection_value(connection, 0, ""),
            HTTP.connection_value(connection, 1, ""), "");
        request.bodyLength = HTTP.connection_body_length(connection);
        request.streamingBody = 1;
        request.nativeConnection = connection;
        request.disconnectWatch = 0;
        request.nativeState = (Object)request;
        request.bodyComplete = HTTP.connection_body_complete(connection);
        request.bodyReader = (Function)nativeRequestBodyRead;
        request.bodyReadAll = (Function)nativeRequestBodyReadAll;
        request.bodyCompleteResolver = (Function)nativeRequestBodyComplete;
    }
    request.headerResolver = (Function)nativeRequestHeader;
    request.queryResolver = (Function)nativeRequestQuery;
    request.cookieResolver = (Function)nativeRequestCookie;
    request.formResolver = (Function)nativeRequestForm;
    request.multipartResolver = (Function)nativeRequestMultipart;
    request.multipartNameResolver = (Function)nativeRequestMultipartName;
    return (Object)request;
}

function responseShutdownRequested(response) {
    if (Object.address((Object)response, "shutdownServer") == 0) return 0;
    return response.shutdownServer;
}

function scheduleNextAccept(context, shutdownServer) {
    if (context.autoAccept == 0 || shutdownServer != 0 ||
        context.server.closed != 0 || context.stopping != 0)
        return 0;
    byte[8] capacity = context.maxConnections;
    if (context.rejectOverload != 0)
        capacity = capacity + context.maxPendingRejections;
    if (context.pendingAccepts != 0 ||
        context.activeConnections + context.rejectingConnections >= capacity)
        return 0;
    if (context.requestLimit != 0 &&
        context.acceptedConnections + context.pendingAccepts >=
            context.requestLimit) return 0;
    context.pendingAccepts = context.pendingAccepts + 1;
    byte[8] handler = new Object();
    handler.connection = 0;
    handler.routeActive = 0;
    addHandler((Object)context, (Object)handler);
    handler.task = context.accept((Object)context, (Object)handler);
    Async.detach(handler.task);
    return 1;
}

function resolveBoundedServer(context) {
    if (context.autoAccept == 0 || context.requestLimit == 0 ||
        context.boundedResolved != 0 ||
        context.acceptedConnections < context.requestLimit ||
        context.activeConnections != 0 || context.rejectingConnections != 0 ||
        context.pendingAccepts != 0) return 0;
    context.boundedResolved = 1;
    Async.resolve(context.done, byte(01));
    return 1;
}

function prepareResponse(connection, response) {
    byte[8] header = response.headerHead;
    while (header != 0) {
        HTTP.connection_response_header(connection, header.name, header.value);
        header = (Object)header.next;
    }
    byte[8] trailer = response.trailerHead;
    while (trailer != 0) {
        HTTP.connection_response_trailer(connection, trailer.name, trailer.value);
        trailer = (Object)trailer.next;
    }
    return HTTP.connection_keep_alive(connection);
}

async function serveConnection(context, handler) {
    byte[32] connection = byte(00);
    try {
        connection = await HTTP.server_accept_socket_async(context.server.handle);
    } catch acceptFailure {
        context.pendingAccepts = context.pendingAccepts - 1;
        scheduleNextAccept((Object)context, 0);
        return 0;
    }
    context.pendingAccepts = context.pendingAccepts - 1;
    context.acceptedConnections = context.acceptedConnections + 1;
    handler.connection = connection;
    if (context.activeConnections >= context.maxConnections) {
        context.rejectingConnections = context.rejectingConnections + 1;
        scheduleNextAccept((Object)context, 0);
        try {
            try {
                byte[1] ready = await HTTP.connection_request_async(connection);
                if (ready == 0) return 0;
            } catch requestFailure {
                return 0;
            }
            byte[1] rejected = await HTTP.connection_reject_overload_async(
                connection, context.retryAfterSeconds);
        } finally {
            HTTP.connection_close(connection);
            context.rejectingConnections = context.rejectingConnections - 1;
            scheduleNextAccept((Object)context, 0);
            resolveBoundedServer((Object)context);
        }
        return 0;
    }
    context.activeConnections = context.activeConnections + 1;
    scheduleNextAccept((Object)context, 0);
    try {
        try {
            byte[1] ready = await HTTP.connection_request_async(connection);
            if (ready == 0) return 0;
        } catch requestFailure {
            return 0;
        }
        byte[8] running = 1;
        while (running != 0) {
            byte[8] requestRegion = celest_cleanup_region_begin();
            try {
            byte[8] request = createNativeRequest(connection,
                context.requestPrototype);
            byte[8] dispatch = new Object();
            dispatch.result = context.app.dispatchFast((Object)request);
            byte[8] response = 0;
            if (Async.is_task(dispatch.result) != 0) {
                handler.routeActive = 1;
                byte[8] route = new Object();
                route.task = dispatch.result;
                addRoute((Object)context, (Object)route);
                byte[32] requestDeadline = byte(00);
                if (context.requestTimeoutMs != 0)
                    requestDeadline = Async.deadline(route.task,
                        context.requestTimeoutMs);
                byte[8] disconnectWatch = HTTP.connection_watch_disconnect(
                    connection, route.task);
                request.nativeState.disconnectWatch = disconnectWatch;
                try {
                    response = await route.task;
                } finally {
                    if (disconnectWatch != 0)
                        HTTP.connection_unwatch_disconnect(connection,
                            disconnectWatch);
                    if (requestDeadline != 0)
                        Async.deadline_close(requestDeadline);
                    removeRoute((Object)context, (Object)route);
                    handler.routeActive = 0;
                }
            } else {
                response = dispatch.result;
            }
            handler.responseActive = 1;
            byte[8] shutdownServer = responseShutdownRequested((Object)response);
            if (shutdownServer != 0) context.stopping = 1;
            if (response.websocket != 0) {
                byte[8] websocket = new Object();
                websocket.connection = connection;
                websocket.options = response.websocket;
                await serveWebSocket((Object)websocket);
                return 1;
            }
            byte[8] keepAlive = prepareResponse(connection, (Object)response);
            if (response.streamBody != 0) {
                byte[1] started = await HTTP.connection_stream_begin_async(connection,
                    response.status, response.contentType, keepAlive);
                byte[8] stream = new NativeResponseStream(connection);
                byte[8] production = new Object();
                production.result = response.streamBody((Object)stream);
                if (Async.is_task(production.result) != 0) await production.result;
                if (stream.state == 1) await stream.close();
                else if (stream.state != 3)
                    throw "response stream producer left a pending write";
            } else await HTTP.connection_respond_persistent_async(connection, response.status,
                    response.body, response.contentType, keepAlive);
            if (Object.address((Object)response, "afterSend") != 0)
                response.afterSend();
            if (keepAlive == 0) {
                if (shutdownServer != 0) {
                    handler.shutdownOwner = 1;
                    context.server.close();
                }
                return 1;
            }
            if (shutdownServer != 0) {
                handler.shutdownOwner = 1;
                context.server.close();
                return 1;
            }
            handler.responseActive = 0;
            running = await HTTP.connection_next_request_async(connection);
            } finally {
                celest_cleanup_region_rollback(requestRegion);
            }
        }
        return 1;
    } catch error {
        if (error != "Task cancelled") {
            try {
                await HTTP.connection_respond_persistent_async(connection, 500,
                    "Internal Server Error", "text/plain; charset=utf-8", 0);
            } catch sendFailure {
            }
        }
        return 1;
    } finally {
        HTTP.connection_close(connection);
        context.activeConnections = context.activeConnections - 1;
        scheduleNextAccept((Object)context, 0);
        resolveBoundedServer((Object)context);
    }
}

async function acceptConnection(context, handler) {
    try {
        return await serveConnection((Object)context, (Object)handler);
    } finally {
        removeHandler((Object)context, (Object)handler);
    }
}

function nativeServerServeOne(app) {
    byte[8] context = new Object();
    context.server = (Object)this;
    context.app = (Object)app;
    context.requestPrototype = web.requestPrototype();
    context.autoAccept = 0;
    context.accept = (Function)acceptConnection;
    context.requestLimit = 1;
    context.maxConnections = 1;
    context.activeConnections = 0;
    context.acceptedConnections = 0;
    context.pendingAccepts = 1;
    context.stopping = 0;
    context.rejectOverload = 0;
    context.retryAfterSeconds = 1;
    context.rejectingConnections = 0;
    context.maxPendingRejections = 1;
    context.boundedResolved = 0;
    context.requestTimeoutMs = 0;
    context.shutdownTimeoutMs = 0;
    byte[8] emptyHandler = 0;
    context.handlerHead = emptyHandler;
    byte[8] emptyRoute = 0;
    context.routeHead = emptyRoute;
    byte[8] handler = new Object();
    handler.connection = 0;
    handler.routeActive = 0;
    addHandler((Object)context, (Object)handler);
    handler.task = acceptConnection((Object)context, (Object)handler);
    return handler.task;
}

function nativeServerServe(options) {
    if (Object.address((Object)this, "lifecycle") != 0)
        return this.lifecycle.done;
    byte[8] context = new Object();
    if (Object.address((Object)options, "tls") != 0)
        this.setTLS((Object)options.tls);
    byte[8] streamRequestBodies = 0;
    if (Object.address((Object)options, "streamRequestBodies") != 0)
        streamRequestBodies = options.streamRequestBodies;
    HTTP.server_request_streaming(this.handle, streamRequestBodies);
    byte[8] headerTimeoutMs = 10000;
    byte[8] bodyTimeoutMs = 30000;
    byte[8] writeTimeoutMs = 30000;
    byte[8] idleTimeoutMs = 60000;
    byte[8] maxConnections = 128;
    byte[8] rejectOverload = 0;
    byte[8] retryAfterSeconds = 1;
    byte[8] maxPendingRejections = 32;
    byte[8] requestTimeoutMs = 0;
    byte[8] shutdownTimeoutMs = 30000;
    if (Object.address((Object)options, "headerTimeoutMs") != 0)
        headerTimeoutMs = options.headerTimeoutMs;
    if (Object.address((Object)options, "bodyTimeoutMs") != 0)
        bodyTimeoutMs = options.bodyTimeoutMs;
    if (Object.address((Object)options, "writeTimeoutMs") != 0)
        writeTimeoutMs = options.writeTimeoutMs;
    if (Object.address((Object)options, "idleTimeoutMs") != 0)
        idleTimeoutMs = options.idleTimeoutMs;
    if (Object.address((Object)options, "maxConnections") != 0)
        maxConnections = options.maxConnections;
    if (Object.address((Object)options, "rejectOverload") != 0)
        rejectOverload = options.rejectOverload;
    if (Object.address((Object)options, "retryAfterSeconds") != 0)
        retryAfterSeconds = options.retryAfterSeconds;
    if (Object.address((Object)options, "maxPendingRejections") != 0)
        maxPendingRejections = options.maxPendingRejections;
    if (Object.address((Object)options, "requestTimeoutMs") != 0)
        requestTimeoutMs = options.requestTimeoutMs;
    if (Object.address((Object)options, "shutdownTimeoutMs") != 0)
        shutdownTimeoutMs = options.shutdownTimeoutMs;
    if (maxConnections <= 0) throw "maxConnections must be positive";
    if (rejectOverload != 0 && rejectOverload != 1)
        throw "rejectOverload must be zero or one";
    if (retryAfterSeconds < 0)
        throw "retryAfterSeconds must not be negative";
    if (maxPendingRejections <= 0)
        throw "maxPendingRejections must be positive";
    if (requestTimeoutMs < 0)
        throw "requestTimeoutMs must not be negative";
    if (shutdownTimeoutMs < 0)
        throw "shutdownTimeoutMs must not be negative";
    HTTP.server_timeouts(this.handle, headerTimeoutMs, bodyTimeoutMs,
        writeTimeoutMs, idleTimeoutMs);
    context.server = (Object)this;
    context.app = (Object)options.app;
    context.requestPrototype = web.requestPrototype();
    context.autoAccept = 1;
    context.accept = (Function)acceptConnection;
    context.requestLimit = options.requestLimit;
    context.maxConnections = maxConnections;
    context.activeConnections = 0;
    context.acceptedConnections = 0;
    context.pendingAccepts = 0;
    context.stopping = 0;
    context.rejectOverload = rejectOverload;
    context.retryAfterSeconds = retryAfterSeconds;
    context.rejectingConnections = 0;
    context.maxPendingRejections = maxPendingRejections;
    context.boundedResolved = 0;
    context.requestTimeoutMs = requestTimeoutMs;
    context.shutdownTimeoutMs = shutdownTimeoutMs;
    byte[8] emptyHandler = 0;
    context.handlerHead = emptyHandler;
    byte[8] emptyRoute = 0;
    context.routeHead = emptyRoute;
    context.done = Async.create();
    scheduleNextAccept((Object)context, 0);
    this.lifecycle = (Object)context;
    return context.done;
}

function nativeServerServeConcurrent(app, requestLimit, workerCount) {
    byte[8] options = new Object();
    options.app = app;
    options.requestLimit = requestLimit;
    return this.serve((Object)options);
}

function initializePrototype() {
    byte[8] prototype = new Object();
    prototype.close = (Function)nativeServerClose;
    prototype.setTLS = (Function)nativeServerSetTLS;
    prototype.serveOne = (Function)nativeServerServeOne;
    prototype.serve = (Function)nativeServerServe;
    prototype.serveConcurrent = (Function)nativeServerServeConcurrent;
    NativeServer.prototype = (Object)prototype;


    byte[8] socketPrototype = new Object();
    socketPrototype.send = (Function)nativeSocketSend;
    socketPrototype.sendBinary = (Function)nativeSocketSendBinary;
    socketPrototype.ping = (Function)nativeSocketPing;
    socketPrototype.pong = (Function)nativeSocketPong;
    socketPrototype.close = (Function)nativeSocketClose;
    NativeSocket.prototype = (Object)socketPrototype;

    byte[8] responseStreamPrototype = new Object();
    responseStreamPrototype.write = (Function)nativeResponseStreamWrite;
    responseStreamPrototype.close = (Function)nativeResponseStreamClose;
    NativeResponseStream.prototype = (Object)responseStreamPrototype;
    return 1;
}

byte[1] prototypeInitialized = initializePrototype();

export function listen(host, port) {
    byte[32] handle = HTTP.server();
    byte[2] boundPort = HTTP.server_bind(handle, host, port);
    return new NativeServer(handle, boundPort);
}

export function serve(app, host, port, requestLimit) {
    byte[8] server = listen(host, port);
    byte[8] options = new Object();
    options.app = app;
    options.requestLimit = requestLimit;
    server.task = server.serve((Object)options);
    return (Object)server;
}

test "creates and closes native listeners" {
    byte[8] server = listen("127.0.0.1", 0);
    if (server.port == 0) throw "native listener did not bind";
    byte[32] closing = server.close();
    byte[1] closed = Async.block_on(closing);
    Async.close(closing);
    if (closed != byte(01)) throw "native listener did not drain";
    if (server.closed == 0) throw "native listener did not close";
}
